<div class="odrite chat-card refazer-prompt">
  <h3 class="chat-card-titulo">{{localize "ODRITE.Conjuracao.RefazerTitulo"}}</h3>
  <p>{{localize "ODRITE.Conjuracao.RefazerPrompt" nome=nome magia=magia}}</p>
  <div class="refazer-botoes">
    <button type="button" data-action="refazer-conjuracao" data-escolha="refazer">{{localize "ODRITE.Conjuracao.Refazer"}}</button>
    <button type="button" data-action="refazer-conjuracao" data-escolha="aceitar">{{localize "ODRITE.Conjuracao.AceitarFalha"}}</button>
  </div>
</div>
