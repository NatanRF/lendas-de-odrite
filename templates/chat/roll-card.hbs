<div class="odrite chat-card {{#if sucesso}}sucesso{{else}}falha{{/if}}">
  <h3 class="chat-card-titulo">{{titulo}}</h3>

  <div class="chat-card-linha">
    <span class="chat-card-label">
      {{#if atributoLabel}}
        {{#if modificadores.length}}{{atributoLabel}} ({{alvoEfetivo}}){{else}}{{atributoLabel}} ({{alvo}}){{/if}}
      {{/if}}
    </span>
    <span class="chat-card-resultado">
      d20: <strong>{{resultadoPrincipal}}</strong>
      {{#if acertoAbsoluto}}
        <span class="tag acerto-absoluto">Acerto Absoluto!</span>
      {{else if falhaAbsoluta}}
        <span class="tag falha-absoluta">Falha Absoluta!</span>
      {{else if sucesso}}
        <span class="tag sucesso">Sucesso</span>
      {{else}}
        <span class="tag falha">Falha</span>
      {{/if}}
    </span>
  </div>

  {{#if modificadores.length}}
  <ul class="chat-card-modificadores">
    <li><span>{{localize "ODRITE.Rolagem.ValorBase"}}</span><span>{{alvo}}</span></li>
    {{#each modificadores as |mod|}}
    <li><span>{{mod.label}}</span><span>{{mod.sinal}}</span></li>
    {{/each}}
    <li class="total"><span>{{localize "ODRITE.Rolagem.TotalEfetivo"}}</span><span>{{alvoEfetivo}}</span></li>
  </ul>
  {{/if}}

  {{#if dadoSecundarioLabel}}
  <div class="chat-card-linha">
    <span class="chat-card-label">{{dadoSecundarioLabel}}</span>
    <span class="chat-card-resultado">
      <strong>{{resultadoSecundario}}</strong>
      {{#if beneficio}}<span class="tag beneficio">Benefício!</span>{{/if}}
    </span>
  </div>
  {{/if}}
</div>
