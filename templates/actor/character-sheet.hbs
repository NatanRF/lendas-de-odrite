<div class="odrite-sheet-body">
<header class="sheet-header">
  <img class="perfil" src="{{actor.img}}" data-action="editImage" data-edit="img" title="{{actor.name}}">
  <div class="cabecalho-central">
    <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'ODRITE.Nome'}}">
    <div class="detalhes-linha">
      <label>{{localize "ODRITE.Raca"}}
        <select name="system.detalhes.raca">
          {{#each racas as |raca|}}
          <option value="{{raca}}" {{#if (eq ../system.detalhes.raca raca)}}selected{{/if}}>{{raca}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "ODRITE.Tamanho"}}<input type="text" name="system.detalhes.tamanho" value="{{system.detalhes.tamanho}}"></label>
      <label>{{localize "ODRITE.Classe"}}
        <select name="system.detalhes.classe">
          {{#each classes as |classe|}}
          <option value="{{classe}}" {{#if (eq ../system.detalhes.classe classe)}}selected{{/if}}>{{classe}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "ODRITE.Deslocamento"}}<input type="number" name="system.detalhes.deslocamento" value="{{system.detalhes.deslocamento}}"> m</label>
    </div>
    <div class="detalhes-linha">
      <label>{{localize "ODRITE.Manobras"}}<input type="number" name="system.manobrasPorRodada" value="{{system.manobrasPorRodada}}"></label>
      <label>{{localize "ODRITE.Experiencia"}}<input type="number" name="system.detalhes.experiencia" value="{{system.detalhes.experiencia}}"></label>
      <button type="button" class="botao-evolucao" data-action="abrirEvolucao">{{localize "ODRITE.Evolucao.Titulo"}}</button>
      <button type="button" class="botao-evolucao" data-action="descansar">{{localize "ODRITE.Descanso.Titulo"}}</button>
      <button type="button" class="botao-evolucao" data-action="fadigaViagem">{{localize "ODRITE.Viagem.Titulo"}}</button>
    </div>
    {{#if acoesLivres}}
    <div class="linha-ecos">
      <span class="rotulo-ecos">{{localize "ODRITE.AcaoLivre.Titulo"}}:</span>
      {{#each acoesLivres as |acao|}}
      <span class="tag">{{acao.label}} {{acao.restantes}}/{{acao.total}}</span>
      {{/each}}
    </div>
    {{/if}}
    {{#if system.morto}}
    <div class="aviso-morte">
      <span class="tag falha">{{localize "ODRITE.Morte.Tag"}}</span>
    </div>
    {{else if system.inconsciente}}
    <div class="aviso-morte">
      <span class="tag falha">{{localize "ODRITE.Morte.InconscienteTag"}}</span>
    </div>
    {{/if}}
    {{#if sangrando}}
    <div class="aviso-sangramento">
      <span class="tag falha">{{localize "ODRITE.Combate.Sangrando"}} ({{sangrando.intensidade}}/turno)</span>
      <button type="button" data-action="estancarSangramento">{{localize "ODRITE.Combate.EstancarSangramento"}}</button>
    </div>
    {{/if}}
    {{#if caido}}
    <div class="aviso-sangramento">
      <span class="tag falha">{{localize "ODRITE.Condicao.Nomeada.Caido"}}</span>
      <button type="button" data-action="levantarSe">{{localize "ODRITE.Condicao.Levantar"}}</button>
    </div>
    {{/if}}
    {{#if imobilizado}}
    <div class="aviso-sangramento">
      <span class="tag falha">{{localize "ODRITE.Condicao.Nomeada.Imobilizado"}}</span>
      <button type="button" data-action="libertarSe">{{localize "ODRITE.Condicao.Libertar"}}</button>
    </div>
    {{/if}}
    {{#if system.transformadoMaldicao}}
    <div class="aviso-maldicao">
      <span class="tag falha">{{localize "ODRITE.Conjuracao.TransformadoMaldicaoTag"}}</span>
    </div>
    {{/if}}
    {{#if ecosAtivos}}
    <div class="linha-ecos">
      <span class="rotulo-ecos">{{localize "ODRITE.Ecos.Titulo"}}:</span>
      {{#each ecosAtivos as |eco|}}
      <span class="tag falha">
        {{eco.label}}{{#if eco.dias}} · {{eco.dias}}d{{/if}}
        <a data-action="limparEco" data-chave="{{eco.chave}}" data-caminho="{{eco.caminho}}" title="{{localize 'ODRITE.Ecos.Limpar'}}">✕</a>
      </span>
      {{/each}}
    </div>
    {{/if}}
    <div class="linha-condicoes">
      {{#each condicoes as |condicao|}}
      <span class="tag condicao {{#if condicao.negativa}}negativa{{else}}positiva{{/if}}" data-item-id="{{condicao.id}}">
        {{condicao.nome}}{{#if condicao.valor}} ({{condicao.valorFormatado}}){{/if}}{{#unless condicao.permanente}} · {{condicao.duracaoRodadas}}r{{/unless}}
        <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a>
        <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a>
      </span>
      {{/each}}
      <button type="button" class="criar-item" data-action="itemCreate" data-type="condicao">+ {{localize "ODRITE.Condicao.Titulo"}}</button>
    </div>
  </div>
</header>

<div class="coluna-atributos">
  {{#each listaAtributos as |atrib|}}
  <div class="atributo">
    <button type="button" class="atributo-rolar" data-action="rollAtributo" data-atributo="{{atrib.chave}}" title="{{localize 'ODRITE.Rolar'}}">
      {{atrib.label}}
    </button>
    <input type="number" name="system.atributos.{{atrib.chave}}.value" value="{{atrib.value}}" min="0" max="14">
  </div>
  {{/each}}
</div>

<nav class="abas">
  <a data-action="switchTab" data-tab="principal" class="{{#if (eq tabAtiva "principal")}}active{{/if}}">{{localize "ODRITE.Aba.Principal"}}</a>
  <a data-action="switchTab" data-tab="magias" class="{{#if (eq tabAtiva "magias")}}active{{/if}}">{{localize "ODRITE.Aba.Magias"}}</a>
  <a data-action="switchTab" data-tab="habilidades" class="{{#if (eq tabAtiva "habilidades")}}active{{/if}}">{{localize "ODRITE.Aba.Habilidades"}}</a>
  <a data-action="switchTab" data-tab="mochila" class="{{#if (eq tabAtiva "mochila")}}active{{/if}}">{{localize "ODRITE.Mochila"}}</a>
  <a data-action="switchTab" data-tab="biografia" class="{{#if (eq tabAtiva "biografia")}}active{{/if}}">{{localize "ODRITE.Aba.Biografia"}}</a>
</nav>

<section class="corpo-ficha">

  <div class="aba-conteudo" data-tab="principal" {{#unless (eq tabAtiva "principal")}}hidden{{/unless}}>
    <div class="cartoes-recurso">
      <div class="cartao cartao-vital">
        <div class="vitalidade-bloco">
          <h3>{{localize "ODRITE.Vitalidade"}}</h3>
          <div class="par par-vitalidade">
            <input type="number" name="system.vitalidade.value" value="{{system.vitalidade.value}}">
            <span>/</span>
            <input type="number" name="system.vitalidade.max" value="{{system.vitalidade.max}}">
          </div>
        </div>

        <div class="fadiga-bloco">
          <h3>{{localize "ODRITE.Fadiga"}}</h3>
          <div class="fadiga-quadros">
            {{#each fadigaBoxes as |caixa|}}
            <button type="button" class="fadiga-quadro grupo-{{caixa.grupo}} {{#if caixa.marcado}}marcado{{/if}}"
                    data-action="toggleFadiga" data-indice="{{caixa.indice}}"
                    title="{{caixa.indice}}"></button>
            {{/each}}
          </div>
          {{#unless (eq system.fadiga.estagio "normal")}}
          <p class="estagio-fadiga estagio-{{system.fadiga.estagio}}">
            {{localize (concat "ODRITE.EstagioFadiga." system.fadiga.estagio)}}
          </p>
          {{/unless}}
        </div>
      </div>

      <div class="proficiencias">
        <h3>{{localize "ODRITE.Proficiencias.Titulo"}}</h3>
        <label>{{localize "ODRITE.Proficiencias.Idiomas"}} <input type="text" name="system.proficiencias.idiomas" value="{{system.proficiencias.idiomas}}"></label>
        <label>{{localize "ODRITE.Proficiencias.Armas"}} <input type="text" name="system.proficiencias.armas" value="{{system.proficiencias.armas}}"></label>
        <label>{{localize "ODRITE.Proficiencias.Armaduras"}} <input type="text" name="system.proficiencias.armaduras" value="{{system.proficiencias.armaduras}}"></label>
        <label>{{localize "ODRITE.Proficiencias.Escudos"}} <input type="text" name="system.proficiencias.escudos" value="{{system.proficiencias.escudos}}"></label>
      </div>

      <div class="cartao cartao-recursos">
        <h3>{{localize "ODRITE.Recursos.Titulo"}}</h3>
        <label>{{localize "ODRITE.Recursos.Drakeons"}} <input type="number" name="system.recursos.drakeons" value="{{system.recursos.drakeons}}"></label>
        <label>{{localize "ODRITE.Recursos.Municao"}}
          <span class="par par-municao">
            <input type="number" name="system.recursos.municao.value" value="{{system.recursos.municao.value}}" min="0" max="{{system.recursos.municao.max}}">
            <span>/ {{system.recursos.municao.max}}</span>
          </span>
        </label>
      </div>
    </div>

    <div class="secao-equipamento">
      <h3>{{localize "ODRITE.Equipamento"}}</h3>

      <div class="nivel-treinamento">
        <span class="nivel-treinamento-label">{{localize "ODRITE.NivelTreinamento"}}</span>
        <div class="nivel-treinamento-pips">
          {{#each nivelTreinamentoPips as |pip|}}
          <button type="button" class="pip-treinamento {{#if pip.marcado}}marcado{{/if}}"
                  data-action="setNivelTreinamento" data-indice="{{pip.indice}}" title="{{pip.indice}}"></button>
          {{/each}}
        </div>
        <span class="nivel-treinamento-dado">1d{{system.dadoTreinamento}}</span>
      </div>

      <div class="equipamento-linha">
        {{#each armaduras as |armadura|}}
        <div class="cartao protecao" data-item-id="{{armadura.id}}">
          <h4>{{localize "ODRITE.Armadura"}} <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a></h4>
          <p>{{armadura.name}} — {{armadura.system.tipo}}</p>
          <label>{{localize "ODRITE.Durabilidade"}} <span>{{armadura.system.durabilidade.value}} / {{armadura.system.durabilidade.max}}</span></label>
          <label>{{localize "ODRITE.Penalidade"}} <span>-{{armadura.system.penalidade}} {{localize "ODRITE.Atributo.Agilidade"}}</span></label>
        </div>
        {{else}}
        <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="armadura">+ {{localize "ODRITE.Armadura"}}</button>
        {{/each}}

        {{#each escudos as |escudo|}}
        <div class="cartao protecao" data-item-id="{{escudo.id}}">
          <h4>{{localize "ODRITE.Escudo"}} <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a></h4>
          <p>{{escudo.name}} — {{escudo.system.tipo}}</p>
          <label>{{localize "ODRITE.Durabilidade"}} <span>{{escudo.system.durabilidade.value}} / {{escudo.system.durabilidade.max}}</span></label>
          <label>{{localize "ODRITE.Penalidade"}} <span>-{{escudo.system.penalidade}} {{localize "ODRITE.Atributo.Agilidade"}}</span></label>
        </div>
        {{else}}
        <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="escudo">+ {{localize "ODRITE.Escudo"}}</button>
        {{/each}}
      </div>

      <div class="equipamento-linha">
        {{#each aljavas as |aljava|}}
        <div class="cartao recurso-equipavel" data-item-id="{{aljava.id}}">
          <h4>{{localize "ODRITE.Aljava"}} <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a></h4>
          <p>{{aljava.name}}</p>
          <label>{{localize "ODRITE.Capacidade"}} <span>{{aljava.system.capacidade}}</span></label>
        </div>
        {{else}}
        <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="item" data-slot="aljava">+ {{localize "ODRITE.Aljava"}}</button>
        {{/each}}

        {{#each cantis as |cantil|}}
        <div class="cartao recurso-equipavel" data-item-id="{{cantil.id}}">
          <h4>{{localize "ODRITE.Cantil"}} <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a></h4>
          <p>{{cantil.name}}</p>
        </div>
        {{else}}
        <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="item" data-slot="cantil">+ {{localize "ODRITE.Cantil"}}</button>
        {{/each}}

        {{#each algibeiras as |algibeira|}}
        <div class="cartao recurso-equipavel" data-item-id="{{algibeira.id}}">
          <h4>{{localize "ODRITE.Algibeira"}} <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a></h4>
          <p>{{algibeira.name}}</p>
        </div>
        {{else}}
        <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="item" data-slot="algibeira">+ {{localize "ODRITE.Algibeira"}}</button>
        {{/each}}
      </div>

      <div class="equipamento-linha">
        <div class="cartao arma-slot" {{#if armaPrincipal}}data-item-id="{{armaPrincipal.id}}"{{/if}}>
          <h4>{{localize "ODRITE.ArmaPrincipal"}}
            {{#if armaPrincipal}}<a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a>{{/if}}
          </h4>
          {{#if armaPrincipal}}
          <button type="button" class="rolar-ataque" data-action="rollAtaque">{{armaPrincipal.name}}</button>
          <p class="arma-detalhes">
            {{localize "ODRITE.Dano"}}: {{armaPrincipal.system.dano}} &nbsp;
            {{localize "ODRITE.Propriedade"}}: {{armaPrincipal.system.propriedade}}<br>
            {{localize "ODRITE.Alcance"}}: {{armaPrincipal.system.alcance}}<br>
            {{localize "ODRITE.Durabilidade"}}: {{armaPrincipal.system.durabilidade.value}}/{{armaPrincipal.system.durabilidade.max}}
          </p>
          {{#if armaPrincipal.system.exigeRecarga}}
            {{#unless armaPrincipal.system.carregada}}
            <button type="button" class="recarregar-arma" data-action="recarregarArma">{{localize "ODRITE.Combate.Recarregar"}}</button>
            {{else}}
            <span class="tag sucesso">{{localize "ODRITE.Combate.Carregada"}}</span>
            {{/unless}}
          {{/if}}
          {{else}}
          <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="arma">+ {{localize "ODRITE.ArmaPrincipal"}}</button>
          {{/if}}
        </div>

        <div class="cartao arma-slot" {{#if armaSecundaria}}data-item-id="{{armaSecundaria.id}}"{{/if}}>
          <h4>{{localize "ODRITE.ArmaSecundaria"}}
            {{#if armaSecundaria}}<a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a> <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a>{{/if}}
          </h4>
          {{#if armaSecundaria}}
          <button type="button" class="rolar-ataque" data-action="rollAtaque">{{armaSecundaria.name}}</button>
          <p class="arma-detalhes">
            {{localize "ODRITE.Dano"}}: {{armaSecundaria.system.dano}} &nbsp;
            {{localize "ODRITE.Propriedade"}}: {{armaSecundaria.system.propriedade}}<br>
            {{localize "ODRITE.Alcance"}}: {{armaSecundaria.system.alcance}}<br>
            {{localize "ODRITE.Durabilidade"}}: {{armaSecundaria.system.durabilidade.value}}/{{armaSecundaria.system.durabilidade.max}}
          </p>
          {{#if armaSecundaria.system.exigeRecarga}}
            {{#unless armaSecundaria.system.carregada}}
            <button type="button" class="recarregar-arma" data-action="recarregarArma">{{localize "ODRITE.Combate.Recarregar"}}</button>
            {{else}}
            <span class="tag sucesso">{{localize "ODRITE.Combate.Carregada"}}</span>
            {{/unless}}
          {{/if}}
          {{else}}
          <button type="button" class="criar-item slot-vazio" data-action="itemCreate" data-type="arma">+ {{localize "ODRITE.ArmaSecundaria"}}</button>
          {{/if}}
        </div>
      </div>
    </div>
  </div>

  <div class="aba-conteudo" data-tab="magias" {{#unless (eq tabAtiva "magias")}}hidden{{/unless}}>
    <div class="linha-fonte-arcana">
      <div class="campo-fonte-arcana">
        <label>{{localize "ODRITE.FonteArcana"}}</label>
        <select name="system.fonteArcana">
          <option value="">—</option>
          {{#each fontesArcanas as |fonte|}}
          <option value="{{fonte}}" {{#if (eq ../system.fonteArcana fonte)}}selected{{/if}}>{{fonte}}</option>
          {{/each}}
        </select>
      </div>

      <div class="campo-caminhos-conjuracao">
        <label>{{localize "ODRITE.CaminhosConjuracao"}}</label>
        <div class="caminhos-conjuracao-selects">
          <select name="system.caminhosConjuracao.um">
            <option value="">—</option>
            {{#each caminhosConjuracao as |caminho|}}
            <option value="{{caminho}}" {{#if (eq ../system.caminhosConjuracao.um caminho)}}selected{{/if}}>{{caminho}}</option>
            {{/each}}
          </select>
          <select name="system.caminhosConjuracao.dois">
            <option value="">—</option>
            {{#each caminhosConjuracao as |caminho|}}
            <option value="{{caminho}}" {{#if (eq ../system.caminhosConjuracao.dois caminho)}}selected{{/if}}>{{caminho}}</option>
            {{/each}}
          </select>
          <select name="system.caminhosConjuracao.tres">
            <option value="">—</option>
            {{#each caminhosConjuracao as |caminho|}}
            <option value="{{caminho}}" {{#if (eq ../system.caminhosConjuracao.tres caminho)}}selected{{/if}}>{{caminho}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>

    <h3>{{localize "ODRITE.Magias"}}</h3>
    <button type="button" class="criar-item slot-vazio slot-lista" data-action="itemCreate" data-type="magia">+ {{localize "ODRITE.Magias"}}</button>
    {{#each magias as |magia|}}
    <div class="cartao magia" data-item-id="{{magia.id}}">
      <h4>
        <button type="button" class="rolar-magia" data-action="rollMagia">{{magia.name}}</button>
        {{#if (includes ../manutencaoAtivaIds magia.id)}}
        <span class="tag tag-manutencao">{{localize "ODRITE.Conjuracao.ManutencaoAtiva"}}</span>
        {{/if}}
        {{#if (includes ../rodadaAtivaIds magia.id)}}
        <span class="tag tag-manutencao">{{localize "ODRITE.Conjuracao.RodadaAtiva"}}</span>
        {{/if}}
        <a data-action="itemEdit">✎</a>
        <a data-action="itemDelete">✕</a>
      </h4>
      <p class="meta">{{localize "ODRITE.Magia.Caminho"}}: {{magia.system.caminho}} | {{localize "ODRITE.Magia.Duracao"}}: {{magia.system.duracao}} | {{localize "ODRITE.Magia.Alcance"}}: {{magia.system.alcance}}</p>
      <div class="descricao">{{{magia.system.descricao}}}</div>
    </div>
    {{/each}}
  </div>

  <div class="aba-conteudo" data-tab="habilidades" {{#unless (eq tabAtiva "habilidades")}}hidden{{/unless}}>
    <h3>{{localize "ODRITE.Habilidades"}}</h3>
    <button type="button" class="criar-item slot-vazio slot-lista" data-action="itemCreate" data-type="habilidade">+ {{localize "ODRITE.Habilidades"}}</button>
    {{#each habilidades as |habilidade|}}
    <div class="cartao habilidade" data-item-id="{{habilidade.id}}">
      <h4>
        {{#if (eq habilidade.system.tipo "passiva")}}
        {{habilidade.name}}
        {{else}}
        <button type="button" class="rolar-habilidade" data-action="rollHabilidade">{{habilidade.name}}</button>
        {{/if}}
        <span class="tag">{{localize (concat "ODRITE.TipoHabilidade." (capitalize habilidade.system.tipo))}}</span>
        <a data-action="itemEdit">✎</a>
        <a data-action="itemDelete">✕</a>
      </h4>
      <div class="descricao">{{{habilidade.system.descricao}}}</div>
    </div>
    {{/each}}
  </div>

  <div class="aba-conteudo" data-tab="mochila" {{#unless (eq tabAtiva "mochila")}}hidden{{/unless}}>
    <div class="carga-info {{#if system.sobrecarregado}}sobrecarregado{{/if}}">
      {{localize "ODRITE.Carga"}}: <strong>{{system.cargaAtual}} / {{system.capacidadeCarga}}</strong>
      {{#if system.sobrecarregado}}<span class="tag falha">{{localize "ODRITE.Sobrecarregado"}}</span>{{/if}}
    </div>

    <div class="lista-mochila">
      <h3>{{localize "ODRITE.Mochila"}} <button type="button" class="criar-item" data-action="itemCreate" data-type="item">+</button></h3>
      {{#each mochila as |objeto|}}
      <div class="linha-item" data-item-id="{{objeto.id}}">
        <span>{{objeto.name}}</span>
        <span>x{{objeto.system.quantidade}}</span>
        <a data-action="itemEdit" title="{{localize 'ODRITE.Editar'}}">✎</a>
        <a data-action="itemDelete" title="{{localize 'ODRITE.Remover'}}">✕</a>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="aba-conteudo" data-tab="biografia" {{#unless (eq tabAtiva "biografia")}}hidden{{/unless}}>
    {{#if (or ferimentosPermanentes.length mutilacoes.length)}}
    <div class="secao-ferimentos">
      <h3>{{localize "ODRITE.Ferimento.Titulo"}}</h3>
      {{#each ferimentosPermanentes as |ferimento|}}
      <p class="linha-ferimento">{{ferimento}}</p>
      {{/each}}
      {{#each mutilacoes as |mutilacao|}}
      <p class="linha-ferimento linha-mutilacao">{{mutilacao}}</p>
      {{/each}}
    </div>
    {{/if}}
    <textarea name="system.detalhes.biografia">{{system.detalhes.biografia}}</textarea>
  </div>

</section>
</div>
