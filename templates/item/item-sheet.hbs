<div class="odrite-sheet-body">
<header class="sheet-header item-header">
  <img class="perfil" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}">
  <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'ODRITE.Nome'}}">
</header>

<section class="corpo-item">

  {{#if (eq tipo "arma")}}
  <div class="campo">
    <label>{{localize "ODRITE.TipoAtaque.Titulo"}}</label>
    <select name="system.tipoAtaque">
      <option value="corpoACorpo" {{#if (eq system.tipoAtaque "corpoACorpo")}}selected{{/if}}>{{localize "ODRITE.TipoAtaque.CorpoACorpo"}}</option>
      <option value="distancia" {{#if (eq system.tipoAtaque "distancia")}}selected{{/if}}>{{localize "ODRITE.TipoAtaque.Distancia"}}</option>
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.CategoriaArma"}}</label>
    <select name="system.categoria">
      {{#each categoriasArma as |cat|}}
      <option value="{{cat}}" {{#if (eq ../system.categoria cat)}}selected{{/if}}>{{cat}}</option>
      {{/each}}
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Dano"}}</label>
    <input type="number" name="system.dano" value="{{system.dano}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Propriedade"}}</label>
    <input type="text" name="system.propriedade" value="{{system.propriedade}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.UsaMunicao"}}</label>
    <input type="checkbox" name="system.usaMunicao" {{#if system.usaMunicao}}checked{{/if}}>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.ExigeRecarga"}}</label>
    <input type="checkbox" name="system.exigeRecarga" {{#if system.exigeRecarga}}checked{{/if}}>
  </div>
  {{#if system.exigeRecarga}}
  <div class="campo">
    <label>{{localize "ODRITE.Combate.Carregada"}}</label>
    <input type="checkbox" name="system.carregada" {{#if system.carregada}}checked{{/if}}>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Preco"}}</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.ForcaMinima"}}</label>
    <input type="number" name="system.forcaMinima" value="{{system.forcaMinima}}" placeholder="0 = sem requisito">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Alcance"}}</label>
    <input type="text" name="system.alcance" value="{{system.alcance}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Empunhadura"}}</label>
    <select name="system.maos">
      {{#each empunhaduras as |opcao|}}
      <option value="{{opcao}}" {{#if (eq ../system.maos opcao)}}selected{{/if}}>{{opcao}}</option>
      {{/each}}
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Durabilidade"}}</label>
    <input type="number" name="system.durabilidade.value" value="{{system.durabilidade.value}}">
    <span>/</span>
    <input type="number" name="system.durabilidade.max" value="{{system.durabilidade.max}}">
  </div>
  {{/if}}

  {{#if (eq tipo "armadura")}}
  <div class="campo">
    <label>{{localize "ODRITE.Tipo"}}</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}" placeholder="Armadura Leve / Média / Pesada">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Preco"}}</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.ForcaMinima"}}</label>
    <input type="number" name="system.forcaMinima" value="{{system.forcaMinima}}" placeholder="0 = sem requisito">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Penalidade"}}</label>
    <input type="number" name="system.penalidade" value="{{system.penalidade}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Durabilidade"}}</label>
    <input type="number" name="system.durabilidade.value" value="{{system.durabilidade.value}}">
    <span>/</span>
    <input type="number" name="system.durabilidade.max" value="{{system.durabilidade.max}}">
  </div>
  {{/if}}

  {{#if (eq tipo "escudo")}}
  <div class="campo">
    <label>{{localize "ODRITE.Tipo"}}</label>
    <input type="text" name="system.tipo" value="{{system.tipo}}" placeholder="Escudo Pequeno / Médio / Grande">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Preco"}}</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.ForcaMinima"}}</label>
    <input type="number" name="system.forcaMinima" value="{{system.forcaMinima}}" placeholder="0 = sem requisito">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Penalidade"}}</label>
    <input type="number" name="system.penalidade" value="{{system.penalidade}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Durabilidade"}}</label>
    <input type="number" name="system.durabilidade.value" value="{{system.durabilidade.value}}">
    <span>/</span>
    <input type="number" name="system.durabilidade.max" value="{{system.durabilidade.max}}">
  </div>
  {{/if}}

  {{#if (eq tipo "magia")}}
  <div class="campo">
    <label>{{localize "ODRITE.Magia.Caminho"}}</label>
    <input type="text" name="system.caminho" value="{{system.caminho}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Magia.Duracao"}}</label>
    <select name="system.duracao">
      <option value="instantaneo" {{#if (eq system.duracao "instantaneo")}}selected{{/if}}>{{localize "ODRITE.Magia.DuracaoInstantaneo"}}</option>
      <option value="manutencao" {{#if (eq system.duracao "manutencao")}}selected{{/if}}>{{localize "ODRITE.Magia.DuracaoManutencao"}}</option>
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Magia.Alcance"}}</label>
    <input type="text" name="system.alcance" value="{{system.alcance}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Dano"}}</label>
    <input type="number" name="system.dano" value="{{system.dano}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Concede"}}</label>
    <input type="checkbox" name="system.concedeCondicao" {{#if system.concedeCondicao}}checked{{/if}}>
  </div>
  {{#if system.concedeCondicao}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Alvo.Titulo"}}</label>
    <select name="system.condicaoAlvo">
      <option value="lancador" {{#if (eq system.condicaoAlvo "lancador")}}selected{{/if}}>{{localize "ODRITE.Condicao.Alvo.Lancador"}}</option>
      <option value="alvo" {{#if (eq system.condicaoAlvo "alvo")}}selected{{/if}}>{{localize "ODRITE.Condicao.Alvo.Alvo"}}</option>
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Nome"}}</label>
    <input type="text" name="system.condicaoNome" value="{{system.condicaoNome}}" placeholder="{{item.name}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Valor"}}</label>
    <input type="number" name="system.condicaoValor" value="{{system.condicaoValor}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Escopo"}}</label>
    <select name="system.condicaoEscopo">
      <option value="qualquer" {{#if (eq system.condicaoEscopo "qualquer")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoQualquer"}}</option>
      <option value="ataque" {{#if (eq system.condicaoEscopo "ataque")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoAtaque"}}</option>
      <option value="manobra" {{#if (eq system.condicaoEscopo "manobra")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoManobra"}}</option>
      <option value="conjuracao" {{#if (eq system.condicaoEscopo "conjuracao")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoConjuracao"}}</option>
      <option value="atributo" {{#if (eq system.condicaoEscopo "atributo")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoAtributo"}}</option>
    </select>
  </div>
  {{#if (eq system.condicaoEscopo "atributo")}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.AtributoEspecifico"}}</label>
    <select name="system.condicaoAtributoEspecifico">
      <option value="">—</option>
      {{#each atributosChaves as |atrib|}}
      <option value="{{atrib.chave}}" {{#if (eq ../system.condicaoAtributoEspecifico atrib.chave)}}selected{{/if}}>{{atrib.label}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Permanente"}}</label>
    <input type="checkbox" name="system.condicaoPermanente" {{#if system.condicaoPermanente}}checked{{/if}}>
  </div>
  {{#unless system.condicaoPermanente}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.DuracaoRodadas"}}</label>
    <input type="number" name="system.condicaoDuracaoRodadas" value="{{system.condicaoDuracaoRodadas}}" min="1">
  </div>
  {{/unless}}
  {{/if}}
  <div class="campo campo-descricao">
    <label>{{localize "ODRITE.Descricao"}}</label>
    <textarea name="system.descricao">{{system.descricao}}</textarea>
  </div>
  {{/if}}

  {{#if (eq tipo "habilidade")}}
  <div class="campo">
    <label>{{localize "ODRITE.TipoHabilidade.Titulo"}}</label>
    <select name="system.tipo">
      <option value="passiva" {{#if (eq system.tipo "passiva")}}selected{{/if}}>{{localize "ODRITE.TipoHabilidade.Passiva"}}</option>
      <option value="ativa" {{#if (eq system.tipo "ativa")}}selected{{/if}}>{{localize "ODRITE.TipoHabilidade.Ativa"}}</option>
      <option value="conjuracao" {{#if (eq system.tipo "conjuracao")}}selected{{/if}}>{{localize "ODRITE.TipoHabilidade.Conjuracao"}}</option>
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.OrigemHabilidade.Titulo"}}</label>
    <select name="system.origem">
      <option value="classe" {{#if (eq system.origem "classe")}}selected{{/if}}>{{localize "ODRITE.OrigemHabilidade.Classe"}}</option>
      <option value="raca" {{#if (eq system.origem "raca")}}selected{{/if}}>{{localize "ODRITE.OrigemHabilidade.Raca"}}</option>
    </select>
  </div>
  {{#if (eq system.origem "raca")}}
  <div class="campo">
    <label>{{localize "ODRITE.Raca"}}</label>
    <select name="system.raca">
      <option value="">—</option>
      {{#each racas as |raca|}}
      <option value="{{raca}}" {{#if (eq ../system.raca raca)}}selected{{/if}}>{{raca}}</option>
      {{/each}}
    </select>
  </div>
  {{else}}
  <div class="campo">
    <label>{{localize "ODRITE.Classe"}}</label>
    <select name="system.classe">
      <option value="">—</option>
      {{#each classes as |classe|}}
      <option value="{{classe}}" {{#if (eq ../system.classe classe)}}selected{{/if}}>{{classe}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.CategoriaHabilidade.Titulo"}}</label>
    <select name="system.categoria">
      <option value="basica" {{#if (eq system.categoria "basica")}}selected{{/if}}>{{localize "ODRITE.CategoriaHabilidade.Basica"}}</option>
      <option value="lista" {{#if (eq system.categoria "lista")}}selected{{/if}}>{{localize "ODRITE.CategoriaHabilidade.Lista"}}</option>
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.AcaoLivre.Concede"}}</label>
    <input type="checkbox" name="system.concedeAcaoLivre" {{#if system.concedeAcaoLivre}}checked{{/if}}>
  </div>
  {{#if system.concedeAcaoLivre}}
  <div class="campo">
    <label>{{localize "ODRITE.AcaoLivre.Tipo"}}</label>
    <select name="system.acaoLivreTipo">
      {{#each acoesLivres as |acao|}}
      <option value="{{acao.chave}}" {{#if (eq ../system.acaoLivreTipo acao.chave)}}selected{{/if}}>{{acao.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.AcaoLivre.PorRodada"}}</label>
    <input type="number" name="system.acaoLivrePorRodada" value="{{system.acaoLivrePorRodada}}" min="1">
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Concede"}}</label>
    <input type="checkbox" name="system.concedeCondicao" {{#if system.concedeCondicao}}checked{{/if}}>
  </div>
  {{#if system.concedeCondicao}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Nome"}}</label>
    <input type="text" name="system.condicaoNome" value="{{system.condicaoNome}}" placeholder="{{item.name}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Valor"}}</label>
    <input type="number" name="system.condicaoValor" value="{{system.condicaoValor}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Escopo"}}</label>
    <select name="system.condicaoEscopo">
      <option value="qualquer" {{#if (eq system.condicaoEscopo "qualquer")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoQualquer"}}</option>
      <option value="ataque" {{#if (eq system.condicaoEscopo "ataque")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoAtaque"}}</option>
      <option value="manobra" {{#if (eq system.condicaoEscopo "manobra")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoManobra"}}</option>
      <option value="conjuracao" {{#if (eq system.condicaoEscopo "conjuracao")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoConjuracao"}}</option>
      <option value="atributo" {{#if (eq system.condicaoEscopo "atributo")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoAtributo"}}</option>
    </select>
  </div>
  {{#if (eq system.condicaoEscopo "atributo")}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.AtributoEspecifico"}}</label>
    <select name="system.condicaoAtributoEspecifico">
      <option value="">—</option>
      {{#each atributosChaves as |atrib|}}
      <option value="{{atrib.chave}}" {{#if (eq ../system.condicaoAtributoEspecifico atrib.chave)}}selected{{/if}}>{{atrib.label}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Permanente"}}</label>
    <input type="checkbox" name="system.condicaoPermanente" {{#if system.condicaoPermanente}}checked{{/if}}>
  </div>
  {{#unless system.condicaoPermanente}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.DuracaoRodadas"}}</label>
    <input type="number" name="system.condicaoDuracaoRodadas" value="{{system.condicaoDuracaoRodadas}}" min="1">
  </div>
  {{/unless}}
  {{/if}}
  <div class="campo campo-descricao">
    <label>{{localize "ODRITE.Descricao"}}</label>
    <textarea name="system.descricao">{{system.descricao}}</textarea>
  </div>
  {{/if}}

  {{#if (eq tipo "item")}}
  <div class="campo">
    <label>{{localize "ODRITE.Quantidade"}}</label>
    <input type="number" name="system.quantidade" value="{{system.quantidade}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Preco"}}</label>
    <input type="number" name="system.preco" value="{{system.preco}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.SlotEspecial.Titulo"}}</label>
    <select name="system.slotEspecial">
      <option value="" {{#if (eq system.slotEspecial "")}}selected{{/if}}>{{localize "ODRITE.SlotEspecial.Nenhum"}}</option>
      <option value="aljava" {{#if (eq system.slotEspecial "aljava")}}selected{{/if}}>{{localize "ODRITE.Aljava"}}</option>
      <option value="cantil" {{#if (eq system.slotEspecial "cantil")}}selected{{/if}}>{{localize "ODRITE.Cantil"}}</option>
      <option value="algibeira" {{#if (eq system.slotEspecial "algibeira")}}selected{{/if}}>{{localize "ODRITE.Algibeira"}}</option>
    </select>
  </div>
  {{#if (eq system.slotEspecial "aljava")}}
  <div class="campo">
    <label>{{localize "ODRITE.Capacidade"}}</label>
    <input type="number" name="system.capacidade" value="{{system.capacidade}}">
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Kit.Funcao"}}</label>
    <select name="system.funcao">
      <option value="" {{#if (eq system.funcao "")}}selected{{/if}}>{{localize "ODRITE.Kit.Nenhuma"}}</option>
      <option value="kitMedicinal" {{#if (eq system.funcao "kitMedicinal")}}selected{{/if}}>{{localize "ODRITE.Kit.Medicinal"}}</option>
      <option value="kitReparo" {{#if (eq system.funcao "kitReparo")}}selected{{/if}}>{{localize "ODRITE.Kit.Reparo"}}</option>
    </select>
  </div>
  {{#if (eq system.funcao "kitMedicinal")}}
  <div class="campo">
    <label>{{localize "ODRITE.Kit.Potencia"}}</label>
    <input type="number" name="system.potencia" value="{{system.potencia}}" min="0">
  </div>
  {{/if}}
  <div class="campo campo-descricao">
    <label>{{localize "ODRITE.Descricao"}}</label>
    <textarea name="system.descricao">{{system.descricao}}</textarea>
  </div>
  {{/if}}

  {{#if (eq tipo "manobra")}}
  <div class="campo">
    <label>{{localize "ODRITE.Ofensiva"}}</label>
    <input type="checkbox" name="system.ofensiva" {{#if system.ofensiva}}checked{{/if}}>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Manobra.Defensiva"}}</label>
    <input type="checkbox" name="system.defensiva" {{#if system.defensiva}}checked{{/if}}>
  </div>
  {{#if system.ofensiva}}
  <div class="campo">
    <label>{{localize "ODRITE.TipoAtaque.Titulo"}}</label>
    <select name="system.tipoAtaque">
      <option value="corpoACorpo" {{#if (eq system.tipoAtaque "corpoACorpo")}}selected{{/if}}>{{localize "ODRITE.TipoAtaque.CorpoACorpo"}}</option>
      <option value="distancia" {{#if (eq system.tipoAtaque "distancia")}}selected{{/if}}>{{localize "ODRITE.TipoAtaque.Distancia"}}</option>
    </select>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Dano"}}</label>
    <input type="number" name="system.dano" value="{{system.dano}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Custo"}}</label>
    <input type="number" name="system.custo" value="{{system.custo}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Propriedade"}}</label>
    <input type="text" name="system.propriedade" value="{{system.propriedade}}">
  </div>
  <div class="campo campo-descricao">
    <label>{{localize "ODRITE.Descricao"}}</label>
    <textarea name="system.descricao">{{system.descricao}}</textarea>
  </div>
  {{/if}}

  {{#if (eq tipo "habilidadeInimigo")}}
  <div class="campo campo-descricao">
    <label>{{localize "ODRITE.Descricao"}}</label>
    <textarea name="system.descricao">{{system.descricao}}</textarea>
  </div>
  {{/if}}

  {{#if (eq tipo "condicao")}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Chave"}}</label>
    <select name="system.chave">
      <option value="">{{localize "ODRITE.Condicao.ChaveNenhuma"}}</option>
      {{#each condicoesNomeadas as |cond|}}
      <option value="{{cond.chave}}" {{#if (eq ../system.chave cond.chave)}}selected{{/if}}>{{cond.label}}</option>
      {{/each}}
    </select>
  </div>
  {{#if (eq system.chave "sangrando")}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Intensidade"}}</label>
    <input type="number" name="system.intensidade" value="{{system.intensidade}}" min="1" max="5">
  </div>
  {{/if}}
  {{#if (eq system.chave "imobilizado")}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.AtributoEscape"}}</label>
    <select name="system.atributoEscape">
      <option value="">—</option>
      {{#each atributosChaves as |atrib|}}
      <option value="{{atrib.chave}}" {{#if (eq ../system.atributoEscape atrib.chave)}}selected{{/if}}>{{atrib.label}}</option>
      {{/each}}
    </select>
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.RemoveAoSofrerDano"}}</label>
    <input type="checkbox" name="system.removeAoSofrerDano" {{#if system.removeAoSofrerDano}}checked{{/if}}>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Valor"}}</label>
    <input type="number" name="system.valor" value="{{system.valor}}">
  </div>
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Escopo"}}</label>
    <select name="system.escopo">
      <option value="qualquer" {{#if (eq system.escopo "qualquer")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoQualquer"}}</option>
      <option value="ataque" {{#if (eq system.escopo "ataque")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoAtaque"}}</option>
      <option value="manobra" {{#if (eq system.escopo "manobra")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoManobra"}}</option>
      <option value="conjuracao" {{#if (eq system.escopo "conjuracao")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoConjuracao"}}</option>
      <option value="atributo" {{#if (eq system.escopo "atributo")}}selected{{/if}}>{{localize "ODRITE.Condicao.EscopoAtributo"}}</option>
    </select>
  </div>
  {{#if (eq system.escopo "atributo")}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.AtributoEspecifico"}}</label>
    <select name="system.atributoEspecifico">
      <option value="">—</option>
      {{#each atributosChaves as |atrib|}}
      <option value="{{atrib.chave}}" {{#if (eq ../system.atributoEspecifico atrib.chave)}}selected{{/if}}>{{atrib.label}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.Permanente"}}</label>
    <input type="checkbox" name="system.permanente" {{#if system.permanente}}checked{{/if}}>
  </div>
  {{#unless system.permanente}}
  <div class="campo">
    <label>{{localize "ODRITE.Condicao.DuracaoRodadas"}}</label>
    <input type="number" name="system.duracaoRodadas" value="{{system.duracaoRodadas}}" min="1">
  </div>
  {{/unless}}
  <div class="campo campo-descricao">
    <label>{{localize "ODRITE.Descricao"}}</label>
    <textarea name="system.descricao">{{system.descricao}}</textarea>
  </div>
  {{/if}}

</section>
</div>
